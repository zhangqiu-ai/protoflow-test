{
  "schemaVersion": 2,
  "prototypeDir": "prototype",
  "anchors": {
    "attribute": "data-pf",
    "requireScreenAnchor": true
  },
  "targets": [
    {
      "id": "web",
      "platform": "web",
      "root": "app",
      "driver": {
        "kind": "playwright-web",
        "urlTemplate": ".protoflow/site/{page}.html"
      },
      "build": {
        "argv": [
          "node",
          "scripts/build.mjs"
        ]
      },
      "functional": {
        "argv": [
          "node",
          "/Users/feature/code/protoflow/node_modules/@playwright/test/cli.js",
          "test",
          "--config",
          "scripts/chat-playwright.config.mjs"
        ],
        "timeoutMs": 120000
      },
      "viewport": {
        "width": 1000,
        "height": 760,
        "scale": 1
      },
      "visual": {
        "mode": "pixel",
        "maxDiffRatio": 0.005
      }
    }
  ],
  "classification": {
    "rules": []
  },
  "policy": {
    "maxRepairAttempts": 2,
    "requireHumanReview": true,
    "sequentialVersions": true,
    "autoApprove": true
  },
  "watch": {
    "pollMs": 200,
    "idleMs": 1000
  },
  "adapters": {
    "codex": {
      "command": {
        "argv": [
          "/Users/feature/.hermes/node/bin/node",
          "/Users/feature/code/protoflow-worktrees/anchor-contracts/scripts/codex-adapter.js",
          "--model",
          "gpt-5.6-terra",
          "--ephemeral"
        ],
        "timeoutMs": 900000
      }
    },
    "specKit": {
      "command": null,
      "install": {
        "argv": [
          "uvx",
          "--from",
          "specify-cli",
          "specify",
          "init",
          "--here",
          "--force",
          "--non-interactive",
          "--integration",
          "codex",
          "--script",
          "sh"
        ],
        "timeoutMs": 600000
      }
    },
    "bmad": {
      "command": null,
      "install": {
        "argv": [
          "npx",
          "--yes",
          "skills",
          "add",
          "bmad-code-org/BMAD-METHOD",
          "--skill",
          "*",
          "--agent",
          "codex",
          "--yes"
        ],
        "timeoutMs": 600000
      }
    }
  },
  "source": {
    "kind": "git",
    "repository": "https://github.com/zhangqiu-ai/protoflow-test.git",
    "branch": "protoflow-anchors-20261008",
    "path": "prototype",
    "startSha": "6f5cb386f8070ea309dbeaafccde1aaa07b5cd0f"
  },
  "runner": {
    "pollMs": 15000,
    "setup": {
      "argv": [
        "node",
        "scripts/setup.mjs"
      ]
    },
    "spec": "scripts/chat-spec.md",
    "delivery": {
      "remote": "origin",
      "branch": "protoflow/anchors-delivery",
      "baseBranch": "anchors-acceptance",
      "merge": "auto"
    }
  }
}
